# reference clones used for development only (opnsense/core, Lachee/opnsense-oidc)
/ref/

# composer artifacts vendored at build time (the lock IS tracked: it is what makes a
# package reproducible, and what "composer audit" checks the advisories against)
src/opnsense/mvc/app/library/OPNsense/SSO/vendor/

# build output
/work/
*.pkg

# test/lab artifacts (Vagrant state, IdP secrets, lab CA private keys)
.vagrant
test/idp/.env
test/idp/*/.env
test/idp/certs/
test/client.ovpn
