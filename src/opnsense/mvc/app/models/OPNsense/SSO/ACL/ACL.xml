<?xml version="1.0"?>
<!--
  Privileges for the two os-sso pages. Deliberately their own rather than folded into
  page-system-usermanager: diagnostics exposes IdP endpoints and the list of open SSO
  sessions (read-only, but not something every operator needs), and the VPN page
  decides how tunnels get authenticated.
-->
<acl>
    <page-system-sso-settings>
        <name>System: Access: SSO VPN web-auth</name>
        <patterns>
            <pattern>ui/sso/settings*</pattern>
            <pattern>api/sso/settings/*</pattern>
        </patterns>
    </page-system-sso-settings>
    <page-system-sso-diagnostics>
        <name>System: Access: SSO Diagnostics</name>
        <patterns>
            <pattern>ui/sso/diagnostics*</pattern>
            <pattern>api/sso/diagnostics/*</pattern>
        </patterns>
    </page-system-sso-diagnostics>
</acl>
