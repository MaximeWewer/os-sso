<?xml version="1.0"?>
<!--
  os-sso settings. Only the OpenVPN deferred web-auth wiring lives here: everything
  else is per-provider and belongs on the authentication server itself.

  This exists so that /usr/local/etc/sso/vpn.conf, which the auth-user-pass-verify
  script reads, stops being a file operators have to create over SSH.

  A LIST of profiles rather than one setting: a firewall routinely runs several OpenVPN
  instances (staff and contractors, or two sites), and with one global provider they
  all had to send their users to the same IdP with the same timeout. Each server names
  its profile as the script's first argument; a server that names none gets the first
  enabled profile, which is what every configuration written before this did.
-->
<model>
    <mount>//OPNsense/SSO/settings</mount>
    <version>1.0.1</version>
    <description>Single Sign-On settings</description>
    <items>
        <vpn>
            <profiles>
                <profile type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <!-- Becomes part of a shell variable name in vpn.conf, and is what
                         the OpenVPN server passes to the script as an argument, so it
                         stays to what both can carry without quoting. -->
                    <name type="TextField">
                        <Required>Y</Required>
                        <Mask>/^[A-Za-z0-9_]{1,32}$/u</Mask>
                        <ValidationMessage>A profile name is 1-32 letters, digits or underscores.</ValidationMessage>
                        <Constraints>
                            <check001>
                                <ValidationMessage>This profile name is already in use.</ValidationMessage>
                                <type>UniqueConstraint</type>
                            </check001>
                        </Constraints>
                    </name>
                    <protocol type="OptionField">
                        <default>oidc</default>
                        <Required>Y</Required>
                        <OptionValues>
                            <oidc>OpenID Connect</oidc>
                            <saml>SAML 2.0</saml>
                        </OptionValues>
                    </protocol>
                    <!-- The list of configured authentication servers, narrowed to the ones
                         os-sso handles: a free-text server name was a typo away from a VPN
                         that defers every login to a provider that does not exist. Stores
                         the server name, same as before. -->
                    <provider type="AuthenticationServerField">
                        <Required>Y</Required>
                        <Filters>
                            <type>/^(oidc|saml)$/</type>
                        </Filters>
                        <ValidationMessage>Select a configured OIDC or SAML authentication server.</ValidationMessage>
                    </provider>
                    <host type="TextField">
                        <Required>Y</Required>
                        <Mask>/^([a-zA-Z0-9.\-]+(:[0-9]{1,5})?)$/u</Mask>
                        <ValidationMessage>Enter the firewall host[:port] the VPN client's browser reaches.</ValidationMessage>
                    </host>
                    <!-- OpenVPN takes the username straight from the client and never checks it
                         again on a deferred-auth path: the browser login decides IF the tunnel
                         comes up, not WHO it belongs to. That matters as soon as the server uses
                         username-as-common-name, a client-config-dir or per-user rules, because
                         those all key off the name the client asked for. -->
                    <enforce_username type="BooleanField">
                        <default>0</default>
                        <Required>Y</Required>
                    </enforce_username>
                    <timeout type="IntegerField">
                        <default>180</default>
                        <Required>Y</Required>
                        <MinimumValue>30</MinimumValue>
                        <MaximumValue>900</MaximumValue>
                        <ValidationMessage>The web-auth timeout must be between 30 and 900 seconds.</ValidationMessage>
                    </timeout>
                </profile>
            </profiles>
        </vpn>
    </items>
</model>
