#!/bin/sh

set -u

# Build the guard manifest before the service starts. A new installation has no
# managed profile yet; an upgrade resumes protection without waiting for a reboot.
SYNC=${SSO_SYNC:-/usr/local/opnsense/scripts/OPNsense/SSO/sync_openvpn.php}
GUARD=${SSO_GUARD:-/usr/local/etc/rc.d/os-sso-vpn-guard}

if ! "$SYNC"; then
    echo "os-sso: installation failed to synchronize managed OpenVPN instances; stopping them" >&2
    "$SYNC" --stop-managed || echo "os-sso: one or more managed OpenVPN instances could not be stopped" >&2
    exit 1
fi
# A forced local-package upgrade does not necessarily run the old package's
# pre-deinstall hook. Restart an existing guard so it loads the newly installed
# code; use a normal start on a clean installation.
if "$GUARD" onestatus >/dev/null 2>&1; then
    GUARD_ACTION=onerestart
else
    GUARD_ACTION=onestart
fi
if ! "$GUARD" "$GUARD_ACTION"; then
    echo "os-sso: installation failed to start or restart the OpenVPN fail-closed guard; stopping managed instances" >&2
    "$SYNC" --stop-managed || echo "os-sso: one or more managed OpenVPN instances could not be stopped" >&2
    exit 1
fi
