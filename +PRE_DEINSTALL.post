#!/bin/sh

set -u

# Removing the verifier from a live firewall must not leave a certificate-only
# managed VPN accepting new connections. Stop the guard first, then every instance
# recorded in its root-owned manifest. The saved directives deliberately remain:
# a manual restart still fails closed until the operator reconfigures the instance.
STATUS=0
/usr/local/etc/rc.d/os-sso-vpn-guard onestop || STATUS=1
/usr/local/opnsense/scripts/OPNsense/SSO/sync_openvpn.php --stop-managed || STATUS=1
if [ "$STATUS" -ne 0 ]; then
    echo "os-sso: deinstallation could not prove every managed OpenVPN instance is stopped" >&2
fi
exit "$STATUS"
